{
  "name": "@finisher/fin-node",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "napi": {
    "binaryName": "fin-node"
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../crates/fin-node/Cargo.toml --output-dir . --no-js && node scripts/copy-workers.mjs",
    "build:test": "napi build --platform --release --manifest-path ../../crates/fin-node/Cargo.toml --output-dir test/native --no-js --features test-hooks && node scripts/copy-workers.mjs --test"
  },
  "devDependencies": {
    "@finisher/core-types": "workspace:*",
    "@napi-rs/cli": "3.10.9",
    "@types/node": "26.6.5"
  }
}
