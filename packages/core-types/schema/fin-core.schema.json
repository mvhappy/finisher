{
  "$defs": {
    "Applied": {
      "description": "The result of applying a transaction to a project.",
      "properties": {
        "bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Placeholder (`$name`) to allocated id.",
          "type": "object"
        },
        "diff": {
          "$ref": "#/$defs/Diff"
        },
        "inverse": {
          "items": {
            "$ref": "#/$defs/Op"
          },
          "type": "array"
        },
        "project": {
          "$ref": "#/$defs/Project"
        }
      },
      "required": [
        "project",
        "diff",
        "inverse",
        "bindings"
      ],
      "type": "object"
    },
    "Asset": {
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "$ref": "#/$defs/Rational"
        },
        "fingerprint": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "path",
        "duration",
        "fingerprint"
      ],
      "type": "object"
    },
    "AudioInfo": {
      "properties": {
        "channels": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "sampleRate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sampleRate",
        "channels"
      ],
      "type": "object"
    },
    "Change": {
      "properties": {
        "change": {
          "$ref": "#/$defs/ChangeKind"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        }
      },
      "required": [
        "kind",
        "id",
        "change"
      ],
      "type": "object"
    },
    "ChangeKind": {
      "enum": [
        "added",
        "removed",
        "updated"
      ],
      "type": "string"
    },
    "Clip": {
      "properties": {
        "asset": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/Rational"
        },
        "id": {
          "type": "string"
        },
        "sourceIn": {
          "$ref": "#/$defs/Rational"
        },
        "start": {
          "$ref": "#/$defs/Rational"
        }
      },
      "required": [
        "id",
        "asset",
        "start",
        "sourceIn",
        "duration"
      ],
      "type": "object"
    },
    "CommittedTx": {
      "description": "A transaction as persisted: with its revision, resolved bindings and diff.",
      "properties": {
        "bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "diff": {
          "$ref": "#/$defs/Diff"
        },
        "rev": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tx": {
          "$ref": "#/$defs/Tx"
        }
      },
      "required": [
        "rev",
        "tx",
        "diff",
        "bindings"
      ],
      "type": "object"
    },
    "CoreError": {
      "description": "A structured, machine-readable error. `code` is a stable `SCREAMING_SNAKE` string.",
      "properties": {
        "code": {
          "type": "string"
        },
        "details": true,
        "fix": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "type": "object"
    },
    "Diff": {
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "type": "array"
        },
        "shifts": {
          "items": {
            "$ref": "#/$defs/Shift"
          },
          "type": "array"
        }
      },
      "required": [
        "changes",
        "shifts"
      ],
      "type": "object"
    },
    "Edge": {
      "description": "Which edge of a clip a trim moves.",
      "enum": [
        "start",
        "end"
      ],
      "type": "string"
    },
    "EngineEvent": {
      "description": "One engine event (`Engine.onEvent`), tagged by `type`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A record imported from the folder.",
          "properties": {
            "tx": {
              "$ref": "#/$defs/CommittedTx"
            },
            "type": {
              "const": "applied",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tx"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The status changed (fin-store's `ProjectStatus`).",
          "properties": {
            "status": true,
            "type": {
              "const": "status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An import took `branch`'s revs from `from_rev` on out of its history: `quarantined`\nrecords were set aside (`own`: some were this server's) and the branch is at\n`generation` of database `incarnation` now.",
          "properties": {
            "branch": {
              "type": "string"
            },
            "fromRev": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "incarnation": {
              "type": "string"
            },
            "own": {
              "type": "boolean"
            },
            "quarantined": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "rewound",
              "type": "string"
            }
          },
          "required": [
            "type",
            "branch",
            "fromRev",
            "quarantined",
            "own",
            "generation",
            "incarnation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The database was rebuilt: a new `incarnation`, and every rev read before may hold\nsomething else now.",
          "properties": {
            "incarnation": {
              "type": "string"
            },
            "type": {
              "const": "rebuilt",
              "type": "string"
            }
          },
          "required": [
            "type",
            "incarnation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A background tick, backup or compaction failed (`fatal`: the engine is gone).",
          "properties": {
            "error": {
              "$ref": "#/$defs/CoreError"
            },
            "fatal": {
              "type": "boolean"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "error",
            "fatal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The first event after registration when the buffer overflowed: `dropped` events\nwere lost.",
          "properties": {
            "dropped": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "lagged",
              "type": "string"
            }
          },
          "required": [
            "type",
            "dropped"
          ],
          "type": "object"
        }
      ]
    },
    "EntityKind": {
      "enum": [
        "asset",
        "track",
        "clip",
        "timeline"
      ],
      "type": "string"
    },
    "Generation": {
      "description": "A branch generation as a caller holds it: the database's incarnation and the branch's\nrewind count in it (module docs).",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "n": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "incarnation",
        "n"
      ],
      "type": "object"
    },
    "Op": {
      "description": "A primitive edit operation, tagged by `op`.",
      "oneOf": [
        {
          "description": "Adds a media asset. `id` is a `$name` placeholder bound to a new `a<n>` id.",
          "properties": {
            "audio": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AudioInfo"
                },
                {
                  "type": "null"
                }
              ]
            },
            "duration": {
              "$ref": "#/$defs/Rational"
            },
            "fingerprint": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "op": {
              "const": "asset.add",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "video": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VideoInfo"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "op",
            "id",
            "path",
            "duration",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "description": "Inserts a clip at `at` on `track`, rippling later clips by `duration`. `id` is a `$name`\nplaceholder; `asset` is an asset id or a placeholder bound earlier in the transaction.",
          "properties": {
            "asset": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/Rational"
            },
            "duration": {
              "$ref": "#/$defs/Rational"
            },
            "id": {
              "type": "string"
            },
            "op": {
              "const": "clip.insert",
              "type": "string"
            },
            "sourceIn": {
              "$ref": "#/$defs/Rational"
            },
            "track": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "track",
            "at",
            "asset",
            "sourceIn",
            "duration"
          ],
          "type": "object"
        },
        {
          "description": "Moves one edge of a clip by `delta` seconds, rippling later clips on the track.",
          "properties": {
            "clip": {
              "type": "string"
            },
            "delta": {
              "$ref": "#/$defs/Rational"
            },
            "edge": {
              "$ref": "#/$defs/Edge"
            },
            "op": {
              "const": "clip.trim",
              "type": "string"
            }
          },
          "required": [
            "op",
            "clip",
            "edge",
            "delta"
          ],
          "type": "object"
        },
        {
          "description": "Removes a clip and closes the gap (ripple).",
          "properties": {
            "clip": {
              "type": "string"
            },
            "op": {
              "const": "clip.delete",
              "type": "string"
            }
          },
          "required": [
            "op",
            "clip"
          ],
          "type": "object"
        },
        {
          "description": "Internal (inverse of `asset.add`): removes an unused asset.",
          "properties": {
            "id": {
              "type": "string"
            },
            "op": {
              "const": "asset.remove",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Internal (inverse of `clip.insert`): removes a clip, rippling when `ripple`.",
          "properties": {
            "id": {
              "type": "string"
            },
            "op": {
              "const": "clip.remove",
              "type": "string"
            },
            "ripple": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "id",
            "ripple"
          ],
          "type": "object"
        },
        {
          "description": "Internal (inverse of `clip.delete`/`clip.remove`): puts `clip` back at its `start`,\nrippling later clips by its duration when `ripple`.",
          "properties": {
            "clip": {
              "$ref": "#/$defs/Clip"
            },
            "op": {
              "const": "clip.restore",
              "type": "string"
            },
            "ripple": {
              "default": true,
              "type": "boolean"
            },
            "track": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "clip",
            "track"
          ],
          "type": "object"
        }
      ]
    },
    "Probe": {
      "description": "What the server needs to register a media asset. Its serde form is what `asset.probe`\nanswers (`@finisher/core-types` exports it as `Probe`).",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "$ref": "#/$defs/Rational"
        },
        "fingerprint": {
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "duration",
        "fingerprint",
        "size"
      ],
      "type": "object"
    },
    "Project": {
      "properties": {
        "assets": {
          "additionalProperties": {
            "$ref": "#/$defs/Asset"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rate": {
          "$ref": "#/$defs/Rational"
        },
        "schemaVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "timeline": {
          "$ref": "#/$defs/Timeline"
        }
      },
      "required": [
        "id",
        "name",
        "schemaVersion",
        "rate",
        "timeline",
        "assets"
      ],
      "type": "object"
    },
    "Rational": {
      "description": "Exact rational seconds in canonical form: \"n/d\" in lowest terms with d > 1, or \"n\" when d is 1; no leading zeros, no \"+\", no \"-0\".",
      "pattern": "^(0|-?[1-9]\\d*)(/[1-9]\\d*)?$",
      "type": "string"
    },
    "SetAside": {
      "additionalProperties": false,
      "description": "A record kept in quarantine ([`TxStatus::SetAside`](crate::TxStatus)). `reason`:\n`SUPERSEDED`, `DIVERGED_TAIL`, `SALVAGED`, `MISSING_FROM_FOLDER`, `STALE_EPOCH`,\n`MALFORMED`, `CONFLICT_COPY`; `origin`: `local`, `folder`, `foreign`, `salvage`.",
      "properties": {
        "branch": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "txId": {
          "type": "string"
        }
      },
      "required": [
        "txId",
        "branch",
        "reason",
        "origin"
      ],
      "type": "object"
    },
    "Shift": {
      "description": "Items on `track` at or after `from` moved by `by` (ripple).",
      "properties": {
        "by": {
          "$ref": "#/$defs/Rational"
        },
        "from": {
          "$ref": "#/$defs/Rational"
        },
        "track": {
          "type": "string"
        }
      },
      "required": [
        "track",
        "from",
        "by"
      ],
      "type": "object"
    },
    "Timeline": {
      "properties": {
        "id": {
          "type": "string"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/Track"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "tracks"
      ],
      "type": "object"
    },
    "Track": {
      "properties": {
        "id": {
          "type": "string"
        },
        "items": {
          "description": "Sorted by `start`, non-overlapping.",
          "items": {
            "$ref": "#/$defs/Clip"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/TrackKind"
        }
      },
      "required": [
        "id",
        "kind",
        "items"
      ],
      "type": "object"
    },
    "TrackKind": {
      "enum": [
        "video",
        "audio"
      ],
      "type": "string"
    },
    "Tx": {
      "properties": {
        "argsHash": {
          "description": "What produced the tx, for a client that sends an idempotency key as `txId`:\n`blake3:<64 hex>` of the command input (op kinds and canonical args, before they were\nresolved against a snapshot). A retry rebuilds `ops` against a newer head (positions\nmove; the stored tx is rebased), so `ops` cannot tell a retry from another command;\nthis can. The store refuses a `txId` it holds with another `argsHash`\n(`IDEM_KEY_REUSED`). Stored with the record, so every server that imported it checks.",
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": "string"
        },
        "baseRev": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "branch": {
          "type": "string"
        },
        "ops": {
          "items": {
            "$ref": "#/$defs/Op"
          },
          "type": "array"
        },
        "schemaVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "txId": {
          "type": "string"
        }
      },
      "required": [
        "txId",
        "author",
        "branch",
        "baseRev",
        "schemaVersion",
        "ops"
      ],
      "type": "object"
    },
    "TxSetAside": {
      "additionalProperties": false,
      "description": "`tx.get` for a transaction that is not (or no longer) on its branch.",
      "properties": {
        "setAside": {
          "$ref": "#/$defs/SetAside"
        }
      },
      "required": [
        "setAside"
      ],
      "type": "object"
    },
    "VideoInfo": {
      "properties": {
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rate": {
          "$ref": "#/$defs/Rational"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "rate"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinCore"
}
