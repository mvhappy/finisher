{
  "$defs": {
    "Applied": {
      "description": "The result of applying a transaction to a project.",
      "properties": {
        "bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Placeholder (`$name`) to allocated id.",
          "type": "object"
        },
        "diff": {
          "$ref": "#/$defs/Diff"
        },
        "inverse": {
          "items": {
            "$ref": "#/$defs/Op"
          },
          "type": "array"
        },
        "project": {
          "$ref": "#/$defs/Project"
        }
      },
      "required": [
        "project",
        "diff",
        "inverse",
        "bindings"
      ],
      "type": "object"
    },
    "Asset": {
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "$ref": "#/$defs/Rational"
        },
        "fingerprint": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "path",
        "duration",
        "fingerprint"
      ],
      "type": "object"
    },
    "AudioInfo": {
      "properties": {
        "channels": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "sampleRate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sampleRate",
        "channels"
      ],
      "type": "object"
    },
    "BranchCreated": {
      "additionalProperties": false,
      "description": "The answer of [`Store::create_branch`](crate::Store::create_branch): the new branch and\nits `branch` record on the parent. `dry_run`: planned and rolled back, nothing kept (a\nretry of a committed create answers with that create, `dry_run` false).",
      "properties": {
        "branch": {
          "$ref": "#/$defs/BranchView"
        },
        "dryRun": {
          "type": "boolean"
        },
        "record": {
          "$ref": "#/$defs/CommittedTx"
        }
      },
      "required": [
        "branch",
        "record",
        "dryRun"
      ],
      "type": "object"
    },
    "BranchState": {
      "enum": [
        "active",
        "archived",
        "merged"
      ],
      "type": "string"
    },
    "BranchView": {
      "additionalProperties": false,
      "description": "A branch as listings show it ([`Store::branches`](crate::Store::branches), `branch.list`):\n`display` is the reference that names it (its name, or `<name>#<id>` for an archived\nbranch or the second holder of a duplicate name); `head` its head seq (its fork seq until\nits first record).",
      "properties": {
        "createdBy": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "forkSeq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "head": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/BranchState"
        }
      },
      "required": [
        "id",
        "name",
        "display",
        "forkSeq",
        "head",
        "state",
        "createdBy"
      ],
      "type": "object"
    },
    "Change": {
      "properties": {
        "change": {
          "$ref": "#/$defs/ChangeKind"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        }
      },
      "required": [
        "kind",
        "id",
        "change"
      ],
      "type": "object"
    },
    "ChangeKind": {
      "enum": [
        "added",
        "removed",
        "updated"
      ],
      "type": "string"
    },
    "Clip": {
      "properties": {
        "asset": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/Rational"
        },
        "id": {
          "type": "string"
        },
        "sourceIn": {
          "$ref": "#/$defs/Rational"
        },
        "start": {
          "$ref": "#/$defs/Rational"
        }
      },
      "required": [
        "id",
        "asset",
        "start",
        "sourceIn",
        "duration"
      ],
      "type": "object"
    },
    "CommittedTx": {
      "description": "A transaction as persisted: with its revision, resolved bindings and diff.",
      "properties": {
        "bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "diff": {
          "$ref": "#/$defs/Diff"
        },
        "link": {
          "anyOf": [
            {
              "$ref": "#/$defs/Link"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's kind and links; omitted for an `edit`. Boxed: most txs are edits, and a\nlink would double the size of every `CommittedTx`."
        },
        "rev": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tx": {
          "$ref": "#/$defs/Tx"
        }
      },
      "required": [
        "rev",
        "tx",
        "diff",
        "bindings"
      ],
      "type": "object"
    },
    "Conflict": {
      "description": "One op that cannot be carried to the head: which op of which tx, why (a reason code), the\nrecord to blame when there is one (else null), and what to do. A re-run failure keeps its\nerror's `details` (an `INVALID_RANGE`'s `min` and `max`, say); other conflicts have none.",
      "properties": {
        "againstTx": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "description": "Boxed: rarely present, and it keeps `Result<_, Conflict>` small."
        },
        "fix": {
          "type": "string"
        },
        "opIndex": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "txId": {
          "type": "string"
        }
      },
      "required": [
        "txId",
        "opIndex",
        "reason",
        "fix"
      ],
      "type": "object"
    },
    "CoreError": {
      "description": "A structured, machine-readable error. `code` is a stable `SCREAMING_SNAKE` string.",
      "properties": {
        "code": {
          "type": "string"
        },
        "details": true,
        "fix": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "type": "object"
    },
    "Diff": {
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "type": "array"
        },
        "shifts": {
          "items": {
            "$ref": "#/$defs/Shift"
          },
          "type": "array"
        }
      },
      "required": [
        "changes",
        "shifts"
      ],
      "type": "object"
    },
    "Edge": {
      "description": "Which edge of a clip a trim moves.",
      "enum": [
        "start",
        "end"
      ],
      "type": "string"
    },
    "EngineEvent": {
      "description": "One engine event (`Engine.onEvent`), tagged by `type`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A record imported from the folder.",
          "properties": {
            "tx": {
              "$ref": "#/$defs/CommittedTx"
            },
            "type": {
              "const": "applied",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tx"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The status changed (fin-store's `ProjectStatus`).",
          "properties": {
            "status": true,
            "type": {
              "const": "status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An import took `branch`'s revs from `from_rev` on out of its history: `quarantined`\nrecords were set aside (`own`: some were this server's) and the branch is at\n`generation` of database `incarnation` now.",
          "properties": {
            "branch": {
              "type": "string"
            },
            "fromRev": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "incarnation": {
              "type": "string"
            },
            "own": {
              "type": "boolean"
            },
            "quarantined": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "rewound",
              "type": "string"
            }
          },
          "required": [
            "type",
            "branch",
            "fromRev",
            "quarantined",
            "own",
            "generation",
            "incarnation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The database was rebuilt: a new `incarnation`, and every rev read before may hold\nsomething else now.",
          "properties": {
            "incarnation": {
              "type": "string"
            },
            "type": {
              "const": "rebuilt",
              "type": "string"
            }
          },
          "required": [
            "type",
            "incarnation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A background tick, backup or compaction failed (`fatal`: the engine is gone).",
          "properties": {
            "error": {
              "$ref": "#/$defs/CoreError"
            },
            "fatal": {
              "type": "boolean"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "error",
            "fatal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The first event after registration when the buffer overflowed: `dropped` events\nwere lost.",
          "properties": {
            "dropped": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "lagged",
              "type": "string"
            }
          },
          "required": [
            "type",
            "dropped"
          ],
          "type": "object"
        }
      ]
    },
    "EntityKind": {
      "enum": [
        "asset",
        "track",
        "clip",
        "timeline"
      ],
      "type": "string"
    },
    "Generation": {
      "description": "A branch generation as a caller holds it: the database's incarnation and the branch's\nrewind count in it (module docs).",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "n": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "incarnation",
        "n"
      ],
      "type": "object"
    },
    "HistoryResult": {
      "additionalProperties": false,
      "description": "The answer of a history operation ([`Store::undo`](crate::Store::undo),\n[`Store::redo`](crate::Store::redo)): the records it committed, in order (or planned and\nrolled back, `dry_run`; a retry of a committed operation answers with its records,\n`dry_run` false), and what they act on: the units an undo undoes, the undo a redo\nreverses, or the merge group a revert reverts. `no_op`: why a cherry-pick or revert\ncommitted nothing (`ALREADY_PRESENT`: the target holds the record's origin root;\n`ALREADY_REVERTED`: the merge group's effect is gone there); absent otherwise.",
      "properties": {
        "committed": {
          "items": {
            "$ref": "#/$defs/CommittedTx"
          },
          "type": "array"
        },
        "dryRun": {
          "type": "boolean"
        },
        "noOp": {
          "type": [
            "string",
            "null"
          ]
        },
        "undone": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "committed",
        "undone",
        "dryRun"
      ],
      "type": "object"
    },
    "Link": {
      "description": "A record's kind and what it points at (spec §4.2). Serialised (in `CommittedTx.link`) as\n`{\"kind\": \"<kind>\", …fields}`, camelCase, absent optional fields omitted.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "edit",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Undoes `undoes` (unit txIds, newest first).",
          "properties": {
            "kind": {
              "const": "undo",
              "type": "string"
            },
            "undoes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "undoes"
          ],
          "type": "object"
        },
        {
          "description": "Reverses the `undo` record `redoes`.",
          "properties": {
            "kind": {
              "const": "redo",
              "type": "string"
            },
            "redoes": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "redoes"
          ],
          "type": "object"
        },
        {
          "description": "A copy of `origin` from branch `from`, in merge group `merge_id`.",
          "properties": {
            "from": {
              "type": "string"
            },
            "kind": {
              "const": "merge",
              "type": "string"
            },
            "mergeId": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "mergeId",
            "from",
            "origin"
          ],
          "type": "object"
        },
        {
          "description": "A copy of `origin` from branch `from`; `origin_hash` names the exact record when known.",
          "properties": {
            "from": {
              "type": "string"
            },
            "kind": {
              "const": "cherryPick",
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "originHash": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "origin",
            "from"
          ],
          "type": "object"
        },
        {
          "description": "Reverts the merge group `reverts`.",
          "properties": {
            "kind": {
              "const": "revert",
              "type": "string"
            },
            "reverts": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reverts"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "checkpoint",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Creates branch `branch_id` forking from this record's branch at `fork_seq` (whose\ntxHash is `fork_hash`, absent at 0), committed at lease epoch `epoch`.",
          "properties": {
            "branchId": {
              "type": "string"
            },
            "epoch": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "forkHash": {
              "type": [
                "string",
                "null"
              ]
            },
            "forkSeq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "branch",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "branchId",
            "name",
            "forkSeq",
            "epoch"
          ],
          "type": "object"
        },
        {
          "description": "Renames, archives or restores branch `branch_id`.",
          "properties": {
            "archived": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "branchId": {
              "type": "string"
            },
            "kind": {
              "const": "branchSet",
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "branchId"
          ],
          "type": "object"
        }
      ]
    },
    "MergeReport": {
      "additionalProperties": false,
      "description": "The answer of [`Store::merge`](crate::Store::merge): merge group `merge_id`'s records on\nthe target, in order (or planned and rolled back, `dry_run`); `merged`: the source txIds\nthey copy; `skipped`: the candidates that conflict and were left on the source (with\n`skipConflicting`; they are offered again by the next merge); `excluded`: source records\nnever offered (`UNDOES_TARGET_RECORDS`); `source_state`: the source branch's state after\nthe merge. A retry of a committed merge answers from the log: its records and their\norigins, `skipped` and `excluded` empty, `dry_run` false. Nothing left to merge is an\nempty answer, not an error.",
      "properties": {
        "committed": {
          "items": {
            "$ref": "#/$defs/CommittedTx"
          },
          "type": "array"
        },
        "dryRun": {
          "type": "boolean"
        },
        "excluded": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "type": "array"
        },
        "mergeId": {
          "type": "string"
        },
        "merged": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "type": "array"
        },
        "sourceState": {
          "$ref": "#/$defs/BranchState"
        }
      },
      "required": [
        "mergeId",
        "committed",
        "merged",
        "skipped",
        "excluded",
        "sourceState",
        "dryRun"
      ],
      "type": "object"
    },
    "Op": {
      "description": "A primitive edit operation, tagged by `op`.",
      "oneOf": [
        {
          "description": "Adds a media asset. `id` is a `$name` placeholder bound to a new `a<n>` id.",
          "properties": {
            "audio": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AudioInfo"
                },
                {
                  "type": "null"
                }
              ]
            },
            "duration": {
              "$ref": "#/$defs/Rational"
            },
            "fingerprint": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "op": {
              "const": "asset.add",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "video": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VideoInfo"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "op",
            "id",
            "path",
            "duration",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "description": "Inserts a clip at `at` on `track`, rippling later clips by `duration`. `id` is a `$name`\nplaceholder; `asset` is an asset id or a placeholder bound earlier in the transaction.",
          "properties": {
            "asset": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/Rational"
            },
            "duration": {
              "$ref": "#/$defs/Rational"
            },
            "id": {
              "type": "string"
            },
            "op": {
              "const": "clip.insert",
              "type": "string"
            },
            "sourceIn": {
              "$ref": "#/$defs/Rational"
            },
            "track": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "track",
            "at",
            "asset",
            "sourceIn",
            "duration"
          ],
          "type": "object"
        },
        {
          "description": "Moves one edge of a clip by `delta` seconds, rippling later clips on the track.",
          "properties": {
            "clip": {
              "type": "string"
            },
            "delta": {
              "$ref": "#/$defs/Rational"
            },
            "edge": {
              "$ref": "#/$defs/Edge"
            },
            "op": {
              "const": "clip.trim",
              "type": "string"
            }
          },
          "required": [
            "op",
            "clip",
            "edge",
            "delta"
          ],
          "type": "object"
        },
        {
          "description": "Removes a clip and closes the gap (ripple).",
          "properties": {
            "clip": {
              "type": "string"
            },
            "op": {
              "const": "clip.delete",
              "type": "string"
            }
          },
          "required": [
            "op",
            "clip"
          ],
          "type": "object"
        },
        {
          "description": "Internal (inverse of `asset.add`): removes an unused asset.",
          "properties": {
            "id": {
              "type": "string"
            },
            "op": {
              "const": "asset.remove",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Internal (inverse of `clip.insert`): removes a clip, rippling when `ripple`.",
          "properties": {
            "id": {
              "type": "string"
            },
            "op": {
              "const": "clip.remove",
              "type": "string"
            },
            "ripple": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "id",
            "ripple"
          ],
          "type": "object"
        },
        {
          "description": "Internal (inverse of `clip.delete`/`clip.remove`): puts `clip` back at its `start`,\nrippling later clips by its duration when `ripple`.",
          "properties": {
            "clip": {
              "$ref": "#/$defs/Clip"
            },
            "op": {
              "const": "clip.restore",
              "type": "string"
            },
            "ripple": {
              "default": true,
              "type": "boolean"
            },
            "track": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "clip",
            "track"
          ],
          "type": "object"
        }
      ]
    },
    "Probe": {
      "description": "What the server needs to register a media asset. Its serde form is what `asset.probe`\nanswers (`@finisher/core-types` exports it as `Probe`).",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "$ref": "#/$defs/Rational"
        },
        "fingerprint": {
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "duration",
        "fingerprint",
        "size"
      ],
      "type": "object"
    },
    "Project": {
      "properties": {
        "assets": {
          "additionalProperties": {
            "$ref": "#/$defs/Asset"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rate": {
          "$ref": "#/$defs/Rational"
        },
        "schemaVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "timeline": {
          "$ref": "#/$defs/Timeline"
        }
      },
      "required": [
        "id",
        "name",
        "schemaVersion",
        "rate",
        "timeline",
        "assets"
      ],
      "type": "object"
    },
    "Rational": {
      "description": "Exact rational seconds in canonical form: \"n/d\" in lowest terms with d > 1, or \"n\" when d is 1; no leading zeros, no \"+\", no \"-0\".",
      "pattern": "^(0|-?[1-9]\\d*)(/[1-9]\\d*)?$",
      "type": "string"
    },
    "RecoverGroup": {
      "additionalProperties": false,
      "description": "One group of quarantined records ([`Store::recover_groups`](crate::Store::recover_groups)).\n\n- `id`: the first record's `txHash`, 12 hex digits (stable on every server);\n- `branch`: the branch the records were on; `fork_seq`, `fork_hash`: the seq and `txHash`\n  the first record continues;\n- `records`, `reasons`: how many, and per quarantine reason; `origin`: the first row's;\n- `server`: the writer's server id (`unknown` when it cannot be told);\n- `first_committed_at`: unix ms; `name`: the branch `create` makes (empty for a group\n  that makes none: it has only records without ops, and its child groups fork where it\n  does);\n- `children`: the groups forking from it, or made by its `branch` records;\n- `recoverable`, `problems`: why `create` leaves it.",
      "properties": {
        "branch": {
          "type": "string"
        },
        "children": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "firstCommittedAt": {
          "format": "int64",
          "type": "integer"
        },
        "forkHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "forkSeq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "problems": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "type": "array"
        },
        "reasons": {
          "additionalProperties": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "records": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "recoverable": {
          "type": "boolean"
        },
        "server": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "branch",
        "forkSeq",
        "records",
        "reasons",
        "origin",
        "server",
        "firstCommittedAt",
        "name",
        "children",
        "recoverable",
        "problems"
      ],
      "type": "object"
    },
    "RecoverReport": {
      "additionalProperties": false,
      "description": "[`Store::recover`](crate::Store::recover)'s answer: the groups as found (before `create`), the branches made and\nevery record written (`branch` records on the parents, the copies, checkpoints), in order,\nfor publishing; `imported`: records read from `import_dir` into quarantine; `manual`: the\nprocedure for a read-only state recovery cannot lift by itself (`CHAIN_FORK`,\n`CONFLICT_COPY`).",
      "properties": {
        "committed": {
          "items": {
            "$ref": "#/$defs/CommittedTx"
          },
          "type": "array"
        },
        "created": {
          "items": {
            "$ref": "#/$defs/BranchView"
          },
          "type": "array"
        },
        "dryRun": {
          "type": "boolean"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/RecoverGroup"
          },
          "type": "array"
        },
        "imported": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "manual": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "groups",
        "created",
        "committed",
        "imported",
        "dryRun"
      ],
      "type": "object"
    },
    "SetAside": {
      "additionalProperties": false,
      "description": "A record kept in quarantine ([`TxStatus::SetAside`](crate::TxStatus)). `reason`:\n`SUPERSEDED`, `DIVERGED_TAIL`, `SALVAGED`, `MISSING_FROM_FOLDER`, `STALE_EPOCH`,\n`MALFORMED`, `CONFLICT_COPY`, `ID_COLLISION`, `IMPORTED`; `origin`: `local`, `folder`,\n`foreign`, `salvage`.",
      "properties": {
        "branch": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "txId": {
          "type": "string"
        }
      },
      "required": [
        "txId",
        "branch",
        "reason",
        "origin"
      ],
      "type": "object"
    },
    "Shift": {
      "description": "Items on `track` at or after `from` moved by `by` (ripple).",
      "properties": {
        "by": {
          "$ref": "#/$defs/Rational"
        },
        "from": {
          "$ref": "#/$defs/Rational"
        },
        "track": {
          "type": "string"
        }
      },
      "required": [
        "track",
        "from",
        "by"
      ],
      "type": "object"
    },
    "Stacks": {
      "description": "An author's undo and redo stacks on a branch, bottom first (the top is the last entry).",
      "properties": {
        "redo": {
          "items": {
            "$ref": "#/$defs/UnitEntry"
          },
          "type": "array"
        },
        "undo": {
          "items": {
            "$ref": "#/$defs/UnitEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "undo",
        "redo"
      ],
      "type": "object"
    },
    "Timeline": {
      "properties": {
        "id": {
          "type": "string"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/Track"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "tracks"
      ],
      "type": "object"
    },
    "Track": {
      "properties": {
        "id": {
          "type": "string"
        },
        "items": {
          "description": "Sorted by `start`, non-overlapping.",
          "items": {
            "$ref": "#/$defs/Clip"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/TrackKind"
        }
      },
      "required": [
        "id",
        "kind",
        "items"
      ],
      "type": "object"
    },
    "TrackKind": {
      "enum": [
        "video",
        "audio"
      ],
      "type": "string"
    },
    "Tx": {
      "properties": {
        "argsHash": {
          "description": "What produced the tx, for a client that sends an idempotency key as `txId`:\n`blake3:<64 hex>` of the command input (op kinds and canonical args, before they were\nresolved against a snapshot). A retry rebuilds `ops` against a newer head (positions\nmove; the stored tx is rebased), so `ops` cannot tell a retry from another command;\nthis can. The store refuses a `txId` it holds with another `argsHash`\n(`IDEM_KEY_REUSED`). Stored with the record, so every server that imported it checks.",
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": "string"
        },
        "baseRev": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "branch": {
          "type": "string"
        },
        "ops": {
          "items": {
            "$ref": "#/$defs/Op"
          },
          "type": "array"
        },
        "schemaVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "txId": {
          "type": "string"
        }
      },
      "required": [
        "txId",
        "author",
        "branch",
        "baseRev",
        "schemaVersion",
        "ops"
      ],
      "type": "object"
    },
    "TxSetAside": {
      "additionalProperties": false,
      "description": "`tx.get` for a transaction that is not (or no longer) on its branch.",
      "properties": {
        "setAside": {
          "$ref": "#/$defs/SetAside"
        }
      },
      "required": [
        "setAside"
      ],
      "type": "object"
    },
    "UnitEntry": {
      "description": "One entry of an undo or redo stack.\n\n- `id`: what an `undo` names in `undoes` (a record's txId, a merge group's `mergeId`, the\n  redo record's txId for a redo unit), or, on the redo stack, the undo record's txId;\n- `records`: the txIds of its records, oldest first: whose stored `inverse` an undo (or,\n  for an undo record, a redo) takes;\n- `last_seq`: the seq of its last record, the frame its inverses apply in.",
      "properties": {
        "id": {
          "type": "string"
        },
        "lastSeq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "records": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/UnitSource",
          "description": "The record whose stored `inverse` an undo uses: the unit's records, or the redo\nrecord that recreated it (Decision 23)."
        }
      },
      "required": [
        "id",
        "records",
        "lastSeq",
        "source"
      ],
      "type": "object"
    },
    "UnitSource": {
      "description": "Where an undo takes a unit's inverse from ([`UnitEntry::source`]).",
      "oneOf": [
        {
          "description": "The unit's own records.",
          "properties": {
            "kind": {
              "const": "records",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The redo record `tx_id`, which recreated an undone unit.",
          "properties": {
            "kind": {
              "const": "redo",
              "type": "string"
            },
            "txId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "txId"
          ],
          "type": "object"
        }
      ]
    },
    "VideoInfo": {
      "properties": {
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rate": {
          "$ref": "#/$defs/Rational"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "rate"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinCore"
}
