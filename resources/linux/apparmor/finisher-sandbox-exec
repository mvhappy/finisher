# AppArmor profile for Finisher's sandbox launcher (plan 7C Decision 26).
#
# Ubuntu 24.04 and later restrict unprivileged user namespaces
# (kernel.apparmor_restrict_unprivileged_userns=1). fin-sandbox-exec needs one to hide the
# user's Unix sockets (D-Bus, ssh-agent, docker.sock, fin.sock) from agent and hook processes;
# without it, they run under Landlock alone and the server warns SANDBOX_SOCKETS_EXPOSED.
#
# This profile names the launcher and allows it to create user namespaces, as Ubuntu's own
# profiles for sandboxing tools do. Confinement comes from the launcher itself: Landlock, the
# namespace's mounts, no capabilities, and no_new_privs. Being unconfined, the profile stays
# on the programs the launcher starts; inside the launcher's namespace they can create no
# further user namespace (its max_user_namespaces is 0).
#
# Installer step (sub-project 9): rewrite the attachment paths to where the launcher is
# installed, copy this file to /etc/apparmor.d/finisher-sandbox-exec, then run
#   apparmor_parser -r /etc/apparmor.d/finisher-sandbox-exec
# where /proc/sys/kernel/apparmor_restrict_unprivileged_userns is 1.

abi <abi/4.0>,
include <tunables/global>

profile finisher-sandbox-exec /{opt/finisher/bin,usr/lib/finisher}/fin-sandbox-exec flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/finisher-sandbox-exec>
}
