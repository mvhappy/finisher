# The session's git configuration (spec §8.3; plan 7C Task 5). `finisherd` writes it to the
# session directory's `git/config` and sets GIT_CONFIG_GLOBAL to it, with GIT_CONFIG_NOSYSTEM=1.
# A repository's own .git/config overrides this file, so Task 11 also passes the fsmonitor and
# credential.helper values through GIT_CONFIG_COUNT (command-line precedence).
[core]
	fsmonitor = false
[credential]
	helper =
[commit]
	gpgsign = false
[tag]
	gpgsign = false
