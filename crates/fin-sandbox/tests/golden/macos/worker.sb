;; P6 = /u/data/jobs/j1/out
;; P7 = /u/data/jobs/j1/tmp
;; P8 = /System
;; P9 = /etc
;; P10 = /tmp
;; P11 = /u
;; P12 = /u/data/jobs
;; P13 = /u/data/jobs/j1
;; P14 = /u/proj
;; P15 = /u/proj/sources
;; P16 = /var
;; P17 = /usr/bin/open
;; P18 = /usr/bin/osascript
;; P19 = /usr/bin/osacompile
;; P20 = /bin/launchctl
;; P21 = /usr/bin/security
