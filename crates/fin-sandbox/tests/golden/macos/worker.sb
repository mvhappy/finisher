;; Generated by fin-sandbox from the worker profile's policy (plan 7C Task 8).
;; Last match wins; every path is a parameter.
(version 1)
(deny default)
(allow file-read* (literal (param "P0")))
(allow file-read* (subpath (param "P1")))
(deny file-read* file-write* process-exec* (subpath (param "P2")))
(allow file-read* (subpath (param "P3")))
(allow file-read* (subpath (param "P4")))
(allow file-read* (subpath (param "P5")))
(allow file-read* file-write* (subpath (param "P6")))
(allow file-read* file-write* (subpath (param "P7")))
(deny file-write-unlink file-write-create
    (literal (param "P6"))
    (literal (param "P7")))
(allow file-read-metadata
    (literal (param "P8"))
    (literal (param "P9"))
    (literal (param "P10"))
    (literal (param "P11"))
    (literal (param "P2"))
    (literal (param "P12"))
    (literal (param "P13"))
    (literal (param "P14"))
    (literal (param "P15"))
    (literal (param "P16")))
(deny file-write-create (vnode-type FIFO))
(allow mach-lookup (global-name "com.apple.MTLCompilerService"))
(allow sysctl-read)
(allow iokit-open-user-client (iokit-user-client-class "AGXDeviceUserClient"))
(deny process-exec*
    (literal (param "P17"))
    (literal (param "P18"))
    (literal (param "P19"))
    (literal (param "P20"))
    (literal (param "P21"))
    (literal (param "P22"))
    (literal (param "P23"))
    (literal (param "P24"))
    (literal (param "P25"))
    (literal (param "P26"))
    (literal (param "P27"))
    (literal (param "P28"))
    (literal (param "P29"))
    (literal (param "P30")))
;; parameters
