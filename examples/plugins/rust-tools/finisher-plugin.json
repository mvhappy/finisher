{
  "manifestVersion": 1,
  "id": "@example/rust-tools",
  "version": "0.1.0",
  "kind": "code",
  "hostApi": "^1.0",
  "license": "MIT",
  "publisher": { "name": "Finisher examples" },
  "platforms": ["darwin-arm64", "linux-x64", "linux-arm64", "win32-x64"],
  "runtime": {
    "type": "native",
    "exec": {
      "darwin-arm64": "bin/darwin-arm64/rust-tools",
      "linux-x64": "bin/linux-x64/rust-tools",
      "linux-arm64": "bin/linux-arm64/rust-tools",
      "win32-x64": "bin/win32-x64/rust-tools.exe"
    }
  },
  "permissions": [
    { "perm": "project:read" },
    { "perm": "project:write" },
    { "perm": "net", "origins": ["https://api.example.org"] }
  ]
}
